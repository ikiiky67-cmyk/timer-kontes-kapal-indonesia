generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
}

enum Division {
  ROV
  ASV
  ERC
  FERC
  IDK
  ISPK
}

enum TeamStatus {
  IDLE
  PREPARING
  RACING
}

model User {
  id       String    @id @default(uuid())
  username String    @unique
  password String
  role     Role
  division Division?
}

model Team {
  id          String     @id @default(uuid())
  name        String
  institution String
  division    Division
  status      TeamStatus @default(IDLE)
  createdAt   DateTime   @default(now())
}

model PrepHistory {
  id            String   @id @default(uuid())
  teamId        String
  targetTime    Int
  remainingTime Int
  mode          String   @default("DOWN")
  createdAt     DateTime @default(now())
}

model RaceHistory {
  id            String   @id @default(uuid())
  teamId        String
  targetTime    Int
  remainingTime Int
  mode          String   @default("DOWN")
  createdAt     DateTime @default(now())
}
